# Copy to .env and fill in. NEVER commit .env.
NODE_ENV=development
PORT=5000
# Local MongoDB or an Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/spendwise
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Where the React app is served from in development (for CORS)
CLIENT_ORIGIN=http://localhost:5173
